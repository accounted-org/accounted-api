NODE_ENV=development
PORT=8081

API_VERSION=v1
BASE_URL=api/${API_VERSION}
DOCS_PREFIX=${API_VERSION}/docs

# DATABASE
DATABASE_URL=postgresql://root:rootpassword@localhost:5432/nest_prisma?schema=public

# DEV
FRONT_DEV_URL=http://localhost:3000/pt

# JWT
JWT_SECRET=your_jwt_secret_key_dev
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_dev
JWT_EXPIRES_IN=3600s
JWT_REFRESH_EXPIRES_IN=7d

# COOKIE

# só usar o domain em ambiente de hml e prd
# COOKIE_DOMAIN=
CORS_ORIGIN=*