generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  id          String   @id @default(cuid())
  amount      Float
  description String?
  date        DateTime @default(now())
  source      String?
  category    String?
  type        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  provider     String
  tokenVersion Int      @default(0)
  mfaEnabled   Boolean
  mfaSecret    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
