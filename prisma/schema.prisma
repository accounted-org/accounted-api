generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  id          String   @id @default(cuid())
  amount      Float
  description String?
  date        DateTime @default(now())
  source      String?
  category    String?
  type        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
